{
  "name": "podcast-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "serve out -l 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:html": "html-validate \"out/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "lhci": "lhci autorun && lhci autorun --config=lighthouserc.typical-4g.json",
    "generate:audio": "node scripts/generate-placeholder-audio.mjs"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "html-validate": "^11.16.2",
    "jsdom": "^30.1.2",
    "lamejs": "^1.2.1",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
